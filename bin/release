#!/usr/bin/env sh

# Prepare a release: bump the version constant, commit, and create the annotated tag `v<version>`.
# Review, then push (`git push --follow-tags`); the pipeline builds the gem and pushes it to
# RubyGems when the tag lands. Pass the exact version (prerelease-aware):
#
#   bin/release 2.0.0.rc1   # cut a release candidate
#   bin/release 2.0.0       # cut the final release
#   bin/release 2.0.1       # a patch release

set -e

version="$1"
if [ -z "$version" ]; then
  printf "Usage: bin/release <version>   e.g. bin/release 2.0.0.rc1\n" 1>&2
  exit 1
fi

if [ "`git symbolic-ref --short HEAD`" != "master" ]; then
  printf "ERROR: only release from the master branch!\n" 1>&2
  exit 2
fi

# `gem bump` (from the gem-release gem) edits lib/rest_framework/version.rb, commits, and `--tag`
# creates the `v<version>` tag. It refuses to run with a dirty tree.
bundle exec gem bump rest_framework --version "$version" --tag

printf "\nTagged v%s locally. Review, then publish:\n\n    git push --follow-tags\n\n" "$version"
